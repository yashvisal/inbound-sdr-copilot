ENVIRONMENT=development
# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:3000
# Path prefix the API is mounted under. Empty locally; set to /api/backend when
# deployed behind the frontend as a Vercel service on one domain.
API_ROOT_PATH=
# Max concurrent lead enrichments for /api/leads/analyze (default 1 for API quota safety).
ENRICHMENT_MAX_CONCURRENCY=1

# Market data - required for meaningful Market Fit scores.
# Free signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Company/property evidence + LLM interpretation (optional but recommended).
# Web search is the primary evidence source. Parallel is the default provider,
# and the same key also powers company-website content extraction:
# https://platform.parallel.ai
PARALLEL_API_KEY=
# Optional fallback, used only when PARALLEL_API_KEY is blank or a Parallel call
# fails. Set WEB_SEARCH_PROVIDER=serper to pin the fallback as the provider.
WEB_SEARCH_PROVIDER=parallel
SERPER_API_KEY=
# Parallel Extract for the company-website step. Set to false to skip it and let
# enrichment fall back to its own raw HTML parse (used by the provider benchmark
# to isolate the Search API from Extract).
WEB_EXTRACT_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_OUTREACH_MODEL=gpt-5.6-terra
NEWS_API_KEY=

# Shared community dashboard + run quotas (optional locally; no-op when blank).
# Free database: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MAX_RUNS_PER_MONTH=100
MAX_RUNS_PER_IP_PER_DAY=3
# Newest community runs kept on the dashboard; samples are pinned and exempt.
COMMUNITY_RUN_LIMIT=50
